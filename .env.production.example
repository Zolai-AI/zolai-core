# =============================================================================
# Zolai Core — Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in the values.
# All secrets are loaded at runtime — never commit real values.
# =============================================================================

# ── API Server ────────────────────────────────────────────────────────────────
# Bind address for the FastAPI server
ZOLAI_API_HOST=0.0.0.0
# Bind port for the FastAPI server
ZOLAI_API_PORT=8000

# ── Auth & Security ──────────────────────────────────────────────────────────
# API auth mode: off | warn | enforce (default: warn)
ZOLAI_API_AUTH=warn
# Enable username/password sessions (default: on)
ZOLAI_AUTH_SESSIONS=on
# Session TTL in hours (default: 12)
ZOLAI_SESSION_TTL_HOURS=12
# Login rate limits (per minute)
ZOLAI_LOGIN_RATE_LIMIT_RPM=5
ZOLAI_LOGIN_RATE_LIMIT_USER_RPM=10

# ── Budget ────────────────────────────────────────────────────────────────────
# Monthly USD budget cap for Gemini API calls
ZOLAI_MONTHLY_BUDGET_USD=50.0

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# pcore-brain (primary AI provider for RAG/assistant)
AI_BRAIN_URL=https://pcore-brain.peterlianpi.site/v1
AI_BRAIN_API_KEY=<brain-api-key>
# Optional: other provider keys
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path inside the container (mounted via docker volume)
ZOLAI_DB_PATH=/app/data/zolai.db
# Leave empty to use SQLite. Set for PostgreSQL in future migrations.
ZOLAI_PG_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ZOLAI_LOG_LEVEL=INFO

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis URL for background tasks, session storage, caching
REDIS_URL=redis://redis:6379

# ── Ollama (optional — for local model inference) ─────────────────────────────
# OLLAMA_URL=http://host.docker.internal:11434
# DEFAULT_MODEL=qwen3-coder:480b-cloud

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS (use * for development only)
ZOLAI_CORS_ORIGINS=*

# ── Notifications (Email) ─────────────────────────────────────────────────────
# SMTP configuration for admin alerts
# Option A: SendGrid (recommended for production)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@zolai.space
SENDGRID_FROM_NAME=Zolai AI
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=<sendgrid-api-key>
# SMTP_FROM=noreply@zolai.space
# SMTP_TLS=true

# Option B: Gmail (current fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=peterpausianlian2020@gmail.com
SMTP_PASS=<gmail-app-password>
SMTP_FROM=pcore.system@gmail.com
SMTP_TLS=true
ADMIN_EMAILS=peterpausianlian2020@gmail.com
ZOLAI_NOTIFICATIONS_ENABLED=true

# ── Circuit Breaker ───────────────────────────────────────────────────────────
ZOLAI_CB_FAILURE_THRESHOLD=5
ZOLAI_CB_TIMEOUT=30
ZOLAI_CB_SUCCESS_THRESHOLD=2
ZOLAI_CB_ENABLED=true