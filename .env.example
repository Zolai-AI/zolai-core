# Database (PostgreSQL for production, SQLite for dev)
ZOLAI_PG_URL=postgresql://user:password@localhost:5432/zolai
# Leave empty to use SQLite (zolai.db)

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Foundation Engine Configuration
FOUNDATION_BATCH_SIZE=1000
FOUNDATION_CONCURRENCY=4
FOUNDATION_AUTO_THRESHOLD=0.95
FOUNDATION_REVIEW_THRESHOLD=0.70

# Server Configuration
ZOLAI_API_HOST=0.0.0.0
ZOLAI_API_PORT=8000
ZOLAI_LOG_LEVEL=INFO

# Data Paths (optional, defaults to workspace root)
# ZOLAI_DATA_DIR=/path/to/data
# ZOLAI_CORPUS_DIR=/path/to/corpus
# ZOLAI_DICTIONARY_DIR=/path/to/dictionary

# Cost Limits (optional)
# ZOLAI_DAILY_COST_LIMIT=10.00
# ZOLAI_MONTHLY_COST_LIMIT=100.00

# Docker (optional)
# ZOLAI_DOCKER_IMAGE=zolai-core:latest
# ZOLAI_DOCKER_TAG=latest