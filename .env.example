# Database (PostgreSQL for production, SQLite for dev)
ZOLAI_PG_URL=postgresql://user:password@localhost:5432/zolai
# Leave empty to use SQLite (zolai.db)

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Foundation Engine Configuration
FOUNDATION_BATCH_SIZE=1000
FOUNDATION_CONCURRENCY=4
FOUNDATION_AUTO_THRESHOLD=0.95
FOUNDATION_REVIEW_THRESHOLD=0.70

# Server Configuration
ZOLAI_API_HOST=0.0.0.0
ZOLAI_API_PORT=8000
ZOLAI_LOG_LEVEL=INFO

# API-key auth on /api/v1 (ADR-014) — no secrets here, mode flags only.
# warn (default, dual-accept window) | enforce (401 without a key) | off
ZOLAI_API_AUTH=warn
# Per-key rate limit in requests/minute (in-memory token bucket)
ZOLAI_API_RATE_LIMIT_RPM=60

# Username accounts + revocable sessions (POST /api/v1/auth/login|logout).
# Accounts are created only by the CLI — `zolai user create` — there is no
# self-registration and no default password, so no secret belongs in this file.
# on (default) | off  — off makes login/logout 404 and the middleware ignore
# every zolai_ss_* token, leaving the tables inert in place (the rollback).
ZOLAI_AUTH_SESSIONS=on
# Session lifetime in hours (default 12)
ZOLAI_SESSION_TTL_HOURS=12
# Login attempts per minute per client IP (default 5) and per username
# (default 10). The username bucket holds even across many source IPs.
ZOLAI_LOGIN_RATE_LIMIT_RPM=5
# ZOLAI_LOGIN_RATE_LIMIT_USER_RPM=10

# Data Paths (optional, defaults to workspace root)
# ZOLAI_DATA_DIR=/path/to/data
# ZOLAI_CORPUS_DIR=/path/to/corpus
# ZOLAI_DICTIONARY_DIR=/path/to/dictionary

# Cost Limits (optional)
# ZOLAI_DAILY_COST_LIMIT=10.00
# ZOLAI_MONTHLY_COST_LIMIT=100.00

# Docker (optional)
# ZOLAI_DOCKER_IMAGE=zolai-core:latest
# ZOLAI_DOCKER_TAG=latest